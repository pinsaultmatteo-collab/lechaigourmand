{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/desinscription",
      "destination": "/api/desinscription"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "python3 outils/generer_catalogue.py && python3 outils/generer_etagere.py || echo 'generation ignoree'",
  "outputDirectory": "."
}
